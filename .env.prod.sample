# ═══════════════════════════════════════════════════════════════
# Valet — plantilla de entorno de PRODUCCIÓN (docker-compose.prod.yml)
#
# Plantilla de referencia: rellena los valores vacíos. Los que traen
# un valor de ejemplo son seguros de dejar tal cual en un sample.
# DATABASE_URL y LOG_LEVEL los fija el propio compose, no van aquí.
# ═══════════════════════════════════════════════════════════════

# ── Ingress / Traefik ───────────────────────────────────────────
# Nombre DNS de la aplicación, SIN esquema. Debe resolver al VPS.
APP_HOST=valet.example.com
# Red externa de Traefik (debe existir de antemano:
#   podman network create traefik).
TRAEFIK_NETWORK=traefik
# Entrypoint HTTPS de Traefik (por defecto en el compose: `websecure`).
TRAEFIK_ENTRYPOINT=websecure
# Resolver ACME configurado en Traefik que emite el certificado TLS.
TRAEFIK_CERT_RESOLVER=letsencrypt

# ── Auth (OIDC / PocketID EXTERNO) ──────────────────────────────
# PocketID NO se levanta aquí: es un IdP externo ya desplegado.
AUTH_ENABLED=true
# Issuer PÚBLICO del PocketID. Debe coincidir EXACTAMENTE con el claim
# `iss` del ID token y ser alcanzable tanto por el navegador como por el
# backend (discovery, intercambio de código y JWKS).
AUTH_ISSUER_URL=https://auth.example.com
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Redirect URI registrada en el cliente OIDC del PocketID.
# AUTH_REDIRECT_URL=https://${APP_HOST}/api/auth/callback
AUTH_REDIRECT_URL=https://valet.example.com/api/auth/callback
# URL de vuelta tras el logout SSO (raíz del SPA).
AUTH_POST_LOGOUT_REDIRECT_URL=https://valet.example.com
# Firma la cookie de sesión (HS256). Genera uno con: openssl rand -hex 32
JWT_SECRET=

# ── LLM (OpenRouter) ────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Embeddings (RAG) — sin esto el RAG queda deshabilitado ──────
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=1024

# ── APIs externas (opcionales) ──────────────────────────────────
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
