# Valet — Local Development Configuration
# Copy this to .env and fill in your keys

# ── Auth (OIDC / PocketID) ────────────────────
# Disabled for local development. Set to "true" when PocketID is available.
AUTH_ENABLED=false
#
# Issuer PÚBLICO del proveedor: el valor del claim `iss` del ID token, que
# navegador y backend deben poder alcanzar. No hay default: con AUTH_ENABLED=true
# debes definirlo explícitamente (p. ej. http://localhost:8080 en local) o el
# arranque aborta.
# AUTH_ISSUER_URL=https://auth.example.com
# Credenciales del cliente OIDC creado en PocketID.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# Redirect URI registrada en el proveedor; debe coincidir EXACTAMENTE con el
# callback del backend: https://TU_DOMINIO/api/auth/callback
# AUTH_REDIRECT_URL=https://TU_DOMINIO/api/auth/callback
# URL pública a la que vuelve el navegador tras el logout SSO (raíz del SPA).
# AUTH_POST_LOGOUT_REDIRECT_URL=https://TU_DOMINIO
# Firma la cookie de sesión (HS256). Usa un valor aleatorio largo en producción.
# JWT_SECRET=change-me-in-production
# ── Producción tras Traefik (PocketID externo) ─
# El stack de producción NO publica puertos: el único ingress es un Traefik
# existente que termina TLS. El único servicio `valet` usa la red externa
# de Traefik.
# APP_HOST va SIN esquema (p. ej. valet.example.com) y debe resolver al VPS.
# PocketID NO se levanta aquí: es un IdP externo ya desplegado; se consume
# fijando AUTH_ISSUER_URL a su issuer público.
# APP_HOST=valet.example.com
# TRAEFIK_NETWORK=traefik
# TRAEFIK_CERT_RESOLVER=letsencrypt

# ── LLM Provider ──────────────────────────────
# Required: at least one of these must be configured.
# OpenRouter (recommended): https://openrouter.ai/keys
OPENROUTER_API_KEY={{ valet_openrouter_api_key }}
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
COLLAPSE_MODEL=deepseek/deepseek-v4-flash
MEMORY_MODEL=mistralai/mistral-small-24b-instruct-2501
SEMANTIC_MODEL=deepseek/deepseek-v4.1-flash
# Extractor de hechos cronológicos (Capa D). Si no se define, cae a MEMORY_MODEL.
TIMELINE_MODEL=mistralai/mistral-small-24b-instruct-2501

# ── Episodic memory ──
MEMORY_BATCH_TOKENS=2000
MEMORY_INACTIVITY_MINUTES=30
MEMORY_OVERLAP=2
MEMORY_POLL_INTERVAL_MINUTES=30

# Ollama (fallback): http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── Embeddings (RAG) ──────────────────────────
# Sin estas variables el RAG queda deshabilitado.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=1024

# ── APIs Externas ────────────────────────
OPENWEATHER_API_KEY={{ valet_openweather_api_key }}
GOOGLE_PLACES_API_KEY={{ valet_google_places_api_key }}
BRAVE_SEARCH_API_KEY={{ valet_brave_search_api_key }}

# ── Strava (OAuth2, un atleta, solo lectura) ──
# Credenciales de la app registrada en https://www.strava.com/settings/api
# (Single Player Mode). También se pueden configurar en Ajustes → Integraciones.
STRAVA_CLIENT_ID={{ valet_strava_client_id | default('') }}
STRAVA_CLIENT_SECRET={{ valet_strava_client_secret | default('') }}
# Opcional: URL absoluta de retorno; si no se define se deduce de las cabeceras.
# STRAVA_REDIRECT_URL=https://TU_DOMINIO/api/strava/callback

# ── Database ──────────────────────────────────
DATABASE_URL=/app/data/valet.db

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
