# Valet — local development configuration
# Copy to .env and fill in your keys.

# ── Server ──
HOST=0.0.0.0
PORT=3000

# ── Auth (OIDC / PocketID) ──
# Disabled by default for local development. Set to "true" when PocketID is available.
AUTH_ENABLED=false
#
# AUTH_ISSUER_URL es el issuer PÚBLICO del proveedor: el mismo valor que
# aparece en el claim `iss` del ID token y que el navegador y el backend
# pueden alcanzar. En local apunta a PocketID; en producción, a su URL TLS.
# AUTH_ISSUER_URL=https://auth.example.com
#
# Credenciales del cliente OIDC creado en PocketID.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
#
# Redirect URI registrada en el proveedor; debe coincidir EXACTAMENTE con el
# callback del backend: https://TU_DOMINIO/api/auth/callback
# AUTH_REDIRECT_URL=https://TU_DOMINIO/api/auth/callback
#
# URL pública a la que el proveedor devuelve el navegador tras el logout SSO
# (la raíz del SPA). En local: http://localhost:3000
# AUTH_POST_LOGOUT_REDIRECT_URL=https://TU_DOMINIO
#
# Firma la cookie de sesión (HS256). Usa un valor aleatorio largo en producción.
# JWT_SECRET=change-me-in-production
#
# ── Producción tras Traefik (PocketID externo) ──
# El stack de producción (docker-compose.prod.yml) NO publica puertos: el
# único ingress es un Traefik existente que termina TLS. El único servicio
# `valet` se une a la red externa de Traefik y se anuncia por labels.
#
# Nombre DNS de la aplicación, SIN esquema (router `valet`). Debe resolver
# al VPS. PocketID NO se levanta aquí: es un proveedor OIDC externo ya
# desplegado, y se consume fijando AUTH_ISSUER_URL a su issuer público.
# APP_HOST=valet.example.com
#
# Red externa de Traefik (por defecto `traefik`). Debe existir de antemano:
#   podman network create traefik
# TRAEFIK_NETWORK=traefik
#
# Resolver ACME configurado en Traefik que emite el certificado TLS.
# TRAEFIK_CERT_RESOLVER=letsencrypt

# ── LLM provider (at least one required) ──
# OpenRouter (recommended): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COLLAPSE_MODEL=deepseek/deepseek-v4-flash
MEMORY_MODEL=mistralai/mistral-small-24b-instruct-2501
SEMANTIC_MODEL=deepseek/deepseek-v4.1-flash

# Ollama fallback
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── External APIs ──
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Database ──
DATABASE_URL=valet.db

# ── Logging ──
LOG_LEVEL=info

# ── Context collapse ──
COLLAPSE_THRESHOLD_TOKENS=2000

# ── Episodic memory ──
MEMORY_BATCH_TOKENS=2000
MEMORY_INACTIVITY_MINUTES=30
MEMORY_OVERLAP=2
MEMORY_POLL_INTERVAL_MINUTES=30

# ── RAG ──
# Token budget for the episodic-memory block injected into the prompt.
# The live value comes from the `settings` table (editable in the UI, read on
# every query); this env var is only the reserve used if the setting is absent.
# The other three memory knobs live in `settings` too, seeded by migration:
#   MEMORY_HALF_LIFE_DAYS  = 90    (how fast relevance decays with age)
#   SIMILARITY_THRESHOLD   = 0.5   (minimum similarity to be retrievable)
#   MEMORY_KNN_CANDIDATES  = 20    (how many KNN candidates are pulled)
RAG_BUDGET_TOKENS=800

# ── Embeddings (RAG) ──
# Sin estas variables el RAG queda deshabilitado.
# EMBEDDING_PROVIDER=openrouter   # openrouter | ollama
# EMBEDDING_MODEL=baai/bge-m3
# EMBEDDING_DIMENSION=1024
